%nav.navbar.navbar-expand.navbar-dark.bg-dark.mb-4
  .container
    = link_to "Dokoiku", root_path, class: "navbar-brand"
    %ul.navbar-nav.ms-auto.align-items-center
      - if user_signed_in?
        %li.nav-item
          = link_to current_user.name, edit_user_registration_path, class: "nav-link"
        %li.nav-item.ms-2
          = button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm"
      - else
        %li.nav-item
          = link_to t("devise.shared.links.sign_in"), new_user_session_path, class: "nav-link"
        %li.nav-item
          = link_to t("devise.shared.links.sign_up"), new_user_registration_path, class: "nav-link"
