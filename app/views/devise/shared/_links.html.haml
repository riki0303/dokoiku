-# パスワードリセット（recoverable）・確認メール（confirmable）は未使用のため、それらへのリンクは出さない
.mt-3
  - if controller_name != "sessions"
    %p.mb-1= link_to t("devise.shared.links.sign_in"), new_session_path(resource_name)
  - if devise_mapping.registerable? && controller_name != "registrations"
    %p.mb-1= link_to t("devise.shared.links.sign_up"), new_registration_path(resource_name)
