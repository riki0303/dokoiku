-# 登録画面と編集画面で共通の入力フォーム。送信ボタンの文言は submit_label で受け取る
= simple_form_for(place) do |f|
  = render "shared/error_messages", model: place
  = f.input :name, autofocus: true, input_html: { maxlength: 100 }
  = f.input :note, input_html: { maxlength: 200 }
  = f.input :distance,
    as: :radio_buttons,
    collection: distance_options
  = f.button :submit, submit_label, class: "btn-primary w-100"
