- content_for :title, "場所を登録する"
.row.justify-content-center
  .col-md-6.col-lg-5
    %h1.h3.mb-4 場所を登録する
    = simple_form_for(@place) do |f|
      = render "shared/error_messages", model: @place
      = f.input :name, autofocus: true, input_html: { maxlength: 100 }
      = f.input :note, input_html: { maxlength: 200 }
      = f.input :distance,
        as: :radio_buttons,
        collection: Place.distances.keys.map { |key| [Place.human_attribute_name("distance.#{key}"), key] }
      = f.button :submit, "登録する", class: "btn-primary w-100"
