- content_for :title, "行きたい場所"
.d-flex.justify-content-between.align-items-center.mb-3
  %h1.h3.mb-0 行きたい場所
  - if @any_places
    = link_to "場所を登録する", new_place_path, class: "btn btn-primary btn-sm"
- if @any_places
  %nav.d-flex.flex-wrap.gap-2.mb-3{ aria: { label: "距離感で絞り込む" } }
    -# 選択中のボタンは塗りつぶしにし、aria-current を付ける
    - [ [ "すべて", nil ], *distance_options ].each do |label, distance|
      - selected = @q.distance_eq.to_s == distance.to_s
      = link_to label,
        places_path(distance ? { q: { distance_eq: distance } } : {}),
        class: [ "btn", selected ? "btn-primary" : "btn-outline-primary" ],
        aria: { current: selected ? "page" : nil }
-# load してから any? を呼び、件数確認と一覧表示の問い合わせを1回にまとめる
-# 0件の理由（登録なし・すべて消化・絞り込んだ結果だけ0件・不正な距離感）によらず、else で同じ案内を出す
- if @any_places && @places.load.any?
  %ul.list-group
    - @places.each do |place|
      %li.list-group-item
        .d-flex.justify-content-between.align-items-start.gap-2
          .fw-bold= place.name
          .d-flex.align-items-center.gap-1.flex-shrink-0
            %span.badge.text-bg-secondary= distance_label(place.distance)
            = link_to "訪問を記録", new_place_visit_path(place), class: "btn btn-link btn-sm py-0"
            = link_to "編集", edit_place_path(place), class: "btn btn-link btn-sm py-0"
        .text-body-secondary= place.note
- else
  %p.text-body-secondary 場所がありません
  = link_to "場所を登録する", new_place_path, class: "btn btn-outline-primary"
