#!/usr/bin/env ruby
# bundler-audit の結果のうち、深刻度が High 以上・不明（Unknown）のものと
# 安全でない gem source だけを表示して失敗させる。High 未満は表示せずに成功させる。
# config/bundler-audit.yml の ignore はこれまでどおり効く。
#
# 動作確認用に、環境変数で Gemfile.lock と設定ファイルのパスを差し替えられる（デフォルトは今のリポジトリ）。
#   BUNDLER_AUDIT_GATE_LOCKFILE=/path/to/Gemfile.lock BUNDLER_AUDIT_GATE_CONFIG=/path/to/bundler-audit.yml bin/bundler-audit-gate
require_relative "../config/boot"
require "bundler/audit/database"
require "bundler/audit/scanner"
require_relative "../lib/audit_severity_gate"

app_root = File.expand_path("..", __dir__)
lockfile = File.expand_path(ENV.fetch("BUNDLER_AUDIT_GATE_LOCKFILE", "Gemfile.lock"), app_root)
config = File.expand_path(ENV.fetch("BUNDLER_AUDIT_GATE_CONFIG", "config/bundler-audit.yml"), app_root)

if Bundler::Audit::Database.exists?
  Bundler::Audit::Database.new.update!(quiet: true)
else
  Bundler::Audit::Database.download(quiet: true)
end
database = Bundler::Audit::Database.new

scanner = Bundler::Audit::Scanner.new(File.dirname(lockfile), File.basename(lockfile), database, config)

blocking_results = scanner.scan.select do |result|
  case result
  when Bundler::Audit::Results::UnpatchedGem
    AuditSeverityGate.blocking?(result.advisory.criticality)
  else
    true # InsecureSource は深刻度に関係なく失敗させる
  end
end
# nokogiri などプラットフォーム別に複数行ある gem は同じ指摘が重複するので1件にまとめる
blocking_results.uniq! do |result|
  case result
  when Bundler::Audit::Results::UnpatchedGem then [ result.gem.name, result.gem.version.to_s, result.advisory.id ]
  else result.source
  end
end

if blocking_results.empty?
  puts "No high or critical vulnerabilities found"
  exit 0
end

blocking_results.each do |result|
  case result
  when Bundler::Audit::Results::UnpatchedGem
    advisory = result.advisory
    puts "Name: #{result.gem.name}"
    puts "Version: #{result.gem.version}"
    puts "Advisory: #{advisory.identifiers.join(', ')}"
    puts "Criticality: #{advisory.criticality || 'unknown'}"
    puts "Title: #{advisory.title}"
    puts "Solution: upgrade to #{advisory.patched_versions.map { |version| "'#{version}'" }.join(', ')}" if advisory.patched_versions.any?
  else
    puts "Insecure Source URI found: #{result.source}"
  end
  puts
end

puts "#{blocking_results.size} high, critical or unknown severity issue(s) found"
exit 1
