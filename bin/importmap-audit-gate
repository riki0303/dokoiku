#!/usr/bin/env ruby
# importmap audit の結果のうち、深刻度が High 以上・不明（Unknown）のものだけを表示して失敗させる。
# High 未満（low / moderate）は表示せずに成功させる。
require_relative "../config/application"
require "importmap/npm"
require_relative "../lib/audit_severity_gate"

app_root = File.expand_path("..", __dir__)
npm = Importmap::Npm.new(File.join(app_root, "config/importmap.rb"), vendor_path: File.join(app_root, "vendor/javascript"))

blocking_packages = npm.vulnerable_packages.select do |package|
  AuditSeverityGate.blocking?(package.severity)
end

if blocking_packages.empty?
  puts "No high or critical vulnerabilities found"
  exit 0
end

blocking_packages.each do |package|
  puts "Package: #{package.name}"
  puts "Severity: #{package.severity.to_s.empty? ? 'unknown' : package.severity}"
  puts "Vulnerable versions: #{package.vulnerable_versions}"
  puts "Vulnerability: #{package.vulnerability}"
  puts
end

puts "#{blocking_packages.size} high, critical or unknown severity vulnerabilit#{blocking_packages.size == 1 ? 'y' : 'ies'} found"
exit 1
